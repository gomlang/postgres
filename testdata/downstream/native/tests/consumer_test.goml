package tests;

use ecosystem::postgres::{PostgresDriver};
use ecosystem::sql::{Driver, Connection, Executor, FromRow, FromValue, Value, Row, Query, Params, Error, ErrorKind};
use std::env;
use std::testing;

struct UserId {
    value: i64,
}

impl FromValue for UserId {
    fn from_value(value: Value) -> Result[UserId, Error] {
        let value: i64 = FromValue::from_value(value)?;
        Result::Ok(UserId { value })
    }
}

struct User {
    id: UserId,
    name: Option[string],
}

impl FromRow for User {
    fn from_row(row: Row) -> Result[User, Error] {
        Result::Ok(User { id: row.get_named("id")?, name: row.get_named("name")? })
    }
}

#[test]
fn downstream_custom_types_and_generic_executor_contract() -> () {
    let dsn = env::var_structured("GOML_POSTGRES_TEST_DSN").unwrap_or("");
    if dsn == "" {
        testing::fail("GOML_POSTGRES_TEST_DSN required");
    }
    let db = testing::expect_ok(PostgresDriver::new().connect(dsn), "driver");
    defer {
        let _ = db.close();
    };
    let query = testing::expect_ok(
        Query::new(
            "SELECT $1::bigint AS id,NULL::text AS name",
            Params::positional(Vec::from_array([Value::Integer(17)])),
        ),
        "parameterized",
    );
    let user: User = testing::expect_ok(db.query_one(query), "consumer FromRow");
    testing::assert_eq(user.id.value, 17);
    testing::assert_none(user.name);
    let query = testing::expect_ok(
        Query::new("SELECT 'wrong'::text AS id,NULL::text AS name", Params::empty()),
        "wrong type",
    );
    let result: Result[User, Error] = db.query_one(query);
    testing::assert_eq(testing::expect_err(result, "conversion").kind, ErrorKind::Conversion);
    testing::assert_eq(db.resources().cursors, 0);
}
